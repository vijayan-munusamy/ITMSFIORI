<mvc:View
    controllerName="itsm.fiori.controller.AssetMaintenance"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Page title="Asset Maintenance" class="sapUiContentPadding">
        <content>
            <VBox class="sapUiSmallMarginBottom">
                <Title text="Maintenance Workflow" level="H2" />
                <Text text="Actor: Asset Manager | Process: Open Maintenance Ticket -> Record Details -> Complete" class="sapUiTinyMarginTop" />
            </VBox>

            <Wizard id="maintenanceWizard" finishButtonText="Complete Maintenance" complete=".onCompleteMaintenance">
                <WizardStep id="stepMaintenanceAsset" title="Select Asset" validated="true">
                    <Table id="maintenanceAssetTable" items="{maintenance>/assets}" noDataText="No assets available for maintenance" class="sapUiSmallMarginTop">
                        <columns>
                            <Column><Text text="Asset" /></Column>
                            <Column><Text text="Current Holder" /></Column>
                            <Column><Text text="Location" /></Column>
                            <Column><Text text="Status" /></Column>
                            <Column width="12rem"><Text text="Action" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{maintenance>name}" text="{maintenance>tag}" />
                                    <Text text="{maintenance>user}" />
                                    <Text text="{maintenance>location}" />
                                    <ObjectStatus text="{maintenance>status}" state="{= ${maintenance>status} === 'Under_Repair' ? 'Warning' : 'Information' }" />
                                    <Button text="Select" type="Emphasized" press=".onSelectAssetForMaintenance" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </WizardStep>

                <WizardStep id="stepTicketDetails" title="Ticket Details" validated="true">
                    <form:SimpleForm layout="ResponsiveGridLayout" title="Maintenance Ticket" editable="true" columnsL="2" columnsM="2">
                        <form:content>
                            <core:Title text="Selected Asset" />
                            <Label text="Asset" />
                            <Text text="{maintenance>/selectedAsset/name} ({maintenance>/selectedAsset/tag})" />
                            
                            <core:Title text="Ticket Information" />
                            <Label text="Vendor" />
                            <Input value="{maintenance>/ticket/vendor}" placeholder="Enter vendor name" width="100%" />

                            <Label text="Issue" />
                            <Input value="{maintenance>/ticket/issue}" placeholder="Describe issue" width="100%" />

                            <Label text="Cost" />
                            <Input value="{maintenance>/ticket/cost}" placeholder="SAR 0" width="100%" />

                            <Label text="Repair Date" />
                            <DatePicker value="{maintenance>/ticket/repairDate}" width="100%" />

                            <Label text="System" />
                            <Input value="{maintenance>/ticket/system}" placeholder="System / module" width="100%" />
                            
                            <Label />
                            <Button text="Open Ticket" type="Emphasized" press=".onOpenMaintenanceTicket" visible="{= ${maintenance>/selectedAsset/status} === 'Assigned' }" width="150px" />
                            <Button text="Update Ticket" type="Emphasized" press=".onOpenMaintenanceTicket" visible="{= ${maintenance>/selectedAsset/status} === 'Under_Repair' }" width="150px" />
                        </form:content>
                    </form:SimpleForm>
                </WizardStep>

                <WizardStep id="stepComplete" title="Complete Maintenance" validated="true">
                    <form:SimpleForm layout="ResponsiveGridLayout" title="Outcome Details" editable="true" columnsL="1" columnsM="1">
                        <form:content>
                            <Label text="Outcome" />
                            <Select id="maintenanceOutcomeSelect" selectedKey="Repaired" width="100%">
                                <items>
                                    <core:Item key="Repaired" text="Repaired" />
                                    <core:Item key="Not Repaired" text="Not Repaired" />
                                </items>
                            </Select>

                            <Label text="If not repaired" />
                            <Select id="maintenanceFailureStatusSelect" selectedKey="Damaged" width="100%">
                                <items>
                                    <core:Item key="Damaged" text="Damaged" />
                                    <core:Item key="Disposed" text="Disposed" />
                                </items>
                            </Select>
                        </form:content>
                    </form:SimpleForm>
                </WizardStep>
            </Wizard>
        </content>
    </Page>
</mvc:View>
