<mvc:View
    controllerName="itsm.fiori.controller.AssetDisposal"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Page title="Asset Disposal" class="sapUiContentPadding">
        <content>
            <VBox class="sapUiSmallMarginBottom">
                <Title text="Disposal Workflow" level="H2" />
                <Text text="Actor: Asset Manager | Request -> Approval -> Dispose" class="sapUiTinyMarginTop" />
            </VBox>

            <Wizard id="disposalWizard" finishButtonText="Confirm Disposal" complete=".onDisposeAsset">
                <WizardStep id="stepDisposalAsset" title="Select Asset" validated="true">
                    <Table id="disposalAssetTable" items="{disposal>/assets}" noDataText="No eligible assets" class="sapUiSmallMarginTop">
                        <columns>
                            <Column><Text text="Asset" /></Column>
                            <Column><Text text="Current Status" /></Column>
                            <Column><Text text="Location" /></Column>
                            <Column><Text text="Request Status" /></Column>
                            <Column width="9rem"><Text text="Action" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{disposal>name}" text="{disposal>tag}" />
                                    <ObjectStatus text="{disposal>status}" state="{disposal>state}" />
                                    <Text text="{disposal>location}" />
                                    <Text text="{disposal>disposalRequest/status}" />
                                    <Button text="Select" press=".onSelectAsset" type="Emphasized" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </WizardStep>

                <WizardStep id="stepCreateRequest" title="Create Disposal Request" validated="true">
                    <form:SimpleForm layout="ResponsiveGridLayout" title="Disposal Details" editable="true" columnsL="1" columnsM="1">
                        <form:content>
                            <Label text="Selected Asset" />
                            <Text text="{disposal>/selectedAsset/name} ({disposal>/selectedAsset/tag})" />
                            <Label text="Current Status" />
                            <Text text="{disposal>/selectedAsset/status}" />

                            <Label text="Reason" />
                            <Select id="disposalReasonSelect" selectedKey="{disposal>/request/reason}" width="100%">
                                <items>
                                    <core:Item key="Obsolete" text="Obsolete" />
                                    <core:Item key="Broken" text="Broken" />
                                    <core:Item key="Beyond Repair" text="Beyond Repair" />
                                    <core:Item key="Warranty Expired" text="Warranty Expired" />
                                </items>
                            </Select>

                            <Label text="Remarks" />
                            <TextArea value="{disposal>/request/remarks}" rows="3" placeholder="Add disposal details" width="100%" />
                            
                            <Label />
                            <Button text="Create Request" type="Emphasized" press=".onCreateDisposalRequest" visible="{= ${disposal>/request/status} === 'Not Requested' || ${disposal>/request/status} === 'Rejected' }" width="200px" />
                        </form:content>
                    </form:SimpleForm>
                </WizardStep>

                <WizardStep id="stepApproval" title="Approval" validated="true">
                    <form:SimpleForm layout="ResponsiveGridLayout" title="Approval Decision" editable="true" columnsL="1" columnsM="1">
                        <form:content>
                            <Label text="Decision" />
                            <Select id="disposalApprovalSelect" selectedKey="Approved" width="100%">
                                <items>
                                    <core:Item key="Approved" text="Approved" />
                                    <core:Item key="Rejected" text="Rejected" />
                                </items>
                            </Select>
                            
                            <Label text="Request Status" />
                            <ObjectStatus text="{disposal>/request/status}" state="{= ${disposal>/request/status} === 'Approved' ? 'Success' : (${disposal>/request/status} === 'Rejected' ? 'Error' : 'Warning') }" />

                            <Label />
                            <Button text="Record Approval" type="Accept" press=".onRecordApproval" visible="{= ${disposal>/request/status} === 'Awaiting Approval' }" width="200px" />
                        </form:content>
                    </form:SimpleForm>
                </WizardStep>
            </Wizard>
        </content>
    </Page>
</mvc:View>
