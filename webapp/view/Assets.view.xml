<mvc:View
    controllerName="itsm.fiori.controller.Assets"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page title="Asset Register" class="sapUiContentPadding">
        <headerContent>
            <Button text="New Asset" icon="sap-icon://add" type="Emphasized" press=".onNewAsset" />
            <Button text="Upload Excel" icon="sap-icon://upload" press=".onUpload" />
            <Button text="Export" icon="sap-icon://download" press=".onExport" />
        </headerContent>
        <content>
            <Toolbar>
                <SearchField width="11rem" placeholder="Search assets" liveChange=".onSearch" />
                <Select selectedKey="All" change=".onStatusFilter" width="10rem">
                    <items>
                        <core:Item key="All" text="All statuses" />
                        <core:Item key="Available" text="Available" />
                        <core:Item key="Assigned" text="Assigned" />
                        <core:Item key="Under_Repair" text="Under Repair" />
                        <core:Item key="Lost" text="Lost" />
                        <core:Item key="Disposed" text="Disposed" />
                    </items>
                </Select>
            </Toolbar>
            <Table id="assetTable" items="{assets>/items}" growing="true" growingThreshold="10" noDataText="No matching assets">
                <columns>
                    <Column><Text text="Asset" /></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Category" /></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Assignment" /></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Location" /></Column>
                    <Column><Text text="Status" /></Column>
                    <Column width="6rem"><Text text="Actions" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onAssetPress">
                        <cells>
                            <ObjectIdentifier title="{assets>name}" text="{assets>tag}" icon="sap-icon://laptop" />
                            <Text text="{assets>category}" />
                            <ObjectAttribute title="Assigned to" text="{assets>user}" />
                            <ObjectAttribute title="Location" text="{assets>location}" />
                            <ObjectStatus text="{assets>status}" state="{assets>state}" />
                            <HBox>
                                <Button icon="sap-icon://edit" type="Transparent" tooltip="Edit asset" press=".onEditAsset" />
                                <Button icon="sap-icon://delete" type="Transparent" tooltip="Delete asset" press=".onDeleteAsset" />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>