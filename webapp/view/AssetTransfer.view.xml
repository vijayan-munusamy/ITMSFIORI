<mvc:View
    controllerName="itsm.fiori.controller.AssetTransfer"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Page title="Asset Transfer" class="sapUiContentPadding">
        <content>
            <VBox class="sapUiSmallMarginBottom">
                <Title text="Asset Transfer Workflow" level="H2" />
                <Text text="Actor: Asset Manager | Process: Select Asset, Select New Employee, Submit" class="sapUiTinyMarginTop" />
            </VBox>

            <Wizard id="transferWizard" finishButtonText="Submit Transfer" complete=".onSubmitTransfer">
                <WizardStep id="stepTransferAsset" title="Select Asset" validated="true">
                    <Table id="transferAssetTable" items="{transfer>/assignedAssets}" noDataText="No assigned assets available for transfer" class="sapUiSmallMarginTop">
                        <columns>
                            <Column><Text text="Asset" /></Column>
                            <Column><Text text="Current Holder" /></Column>
                            <Column><Text text="Location" /></Column>
                            <Column><Text text="Status" /></Column>
                            <Column width="12rem"><Text text="Action" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{transfer>name}" text="{transfer>tag}" />
                                    <Text text="{transfer>user}" />
                                    <Text text="{transfer>location}" />
                                    <ObjectStatus text="{transfer>status}" state="Information" />
                                    <Button text="Select" type="Emphasized" press=".onSelectAssetForTransfer" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </WizardStep>

                <WizardStep id="stepTransferDetails" title="Transfer Details" validated="true">
                    <form:SimpleForm layout="ResponsiveGridLayout" title="Transfer Assignment" editable="true" columnsL="2" columnsM="2">
                        <form:content>
                            <core:Title text="Selected Asset" />
                            <Label text="Asset" />
                            <Text text="{transfer>/selectedAsset/name} ({transfer>/selectedAsset/tag})" />
                            <Label text="Current Holder" />
                            <Text text="{transfer>/selectedAsset/user}" />
                            <Label text="Current Location" />
                            <Text text="{transfer>/selectedAsset/location}" />

                            <core:Title text="New Assignment" />
                            <Label text="Select New Employee" />
                            <Select id="newEmployeeSelect" items="{transfer>/eligibleEmployees}" width="100%">
                                <items>
                                    <core:Item key="{transfer>id}" text="{transfer>name}" />
                                </items>
                            </Select>
                        </form:content>
                    </form:SimpleForm>
                </WizardStep>
            </Wizard>
        </content>
    </Page>
</mvc:View>
